{
  "name": "propertyapp",
  "version": "0.1.0",
  "description": "Aplikacja do zarzadzania wynajmem nieruchomosci - rozliczenia, najemcy, raporty",
  "private": true,
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:defaults": "node scripts/seed.js",
    "import": "node scripts/import-excel.js \"./ROZLICZENIA Z NAJEMCAMI.xlsx\"",
    "import:dryrun": "node scripts/import-excel-dryrun.js \"./ROZLICZENIA Z NAJEMCAMI.xlsx\"",
    "backup": "node scripts/backup.js",
    "seed:fixed-expenses-2026": "node scripts/seed-fixed-expenses-2026.js",
    "smoke": "node scripts/smoke-test.js",
    "test:auth": "node scripts/auth-smoke-test.js",
    "test:finance": "node scripts/finance-regression-test.js",
    "test:rental-model": "node scripts/rental-model-test.js",
    "test:seed-safety": "node scripts/seed-safety-test.js",
    "test:ui": "playwright test",
    "migrate:prod": "npm run migrate",
    "setup": "npm run migrate && npm run seed",
    "setup:dev": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
